# ---- Core ----
# Public base URL used to build meeting links (no trailing slash).
APP_BASE_URL=http://localhost:3000
# PostgreSQL connection string.
DATABASE_URL=postgres://postgres@localhost:5432/meetsphere
# Long random string (>= 32 chars). Used to HMAC OTP codes and session tokens.
APP_SECRET=replace-with-a-long-random-string

# ---- Media (LiveKit) ----
# Leave blank to run without media: the room will show "media not configured".
# For local dev, `livekit-server --dev` uses key "devkey" and secret "secret".
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Phone OTP (Twilio Programmable Messaging) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Email OTP (Resend) ----
RESEND_API_KEY=
EMAIL_FROM=

# ---- Development mode ----
# When "true" AND a provider above is not configured, codes are shown on screen
# with a "DEV MODE - no message sent" label. Never enable in production.
VERIFICATION_DEV_MODE=false

# ---- Plan limits (free tier; there is NO duration cutoff) ----
FREE_MAX_PARTICIPANTS=50
FREE_MAX_INVITATIONS=500
FREE_OTP_SENDS_PER_HOST_PER_DAY=200
