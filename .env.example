# =====================================================================
# MeetSphere configuration. Copy to .env (production) or .env.local (dev).
# Only DATABASE_URL and APP_SECRET are required; everything else enables
# a feature. Missing services are reported honestly in the UI.
# =====================================================================

# ---- Core (required) ----
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://postgres@localhost:5432/meetsphere
# >= 32 random chars: openssl rand -base64 48
APP_SECRET=replace-with-a-long-random-string

# ---- Audio/video: LiveKit ----
# Dev: `livekit-server --dev` uses key "devkey" / secret "secret".
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Phone OTP & SMS invitations: Twilio Programmable Messaging ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Email OTP & email invitations: Resend ----
RESEND_API_KEY=
EMAIL_FROM=

# Show codes on screen when no SMS/email provider is configured. Ignored in production.
VERIFICATION_DEV_MODE=false

# ---- Recording & live streaming storage (LiveKit Egress writes here) ----
# Option A: S3-compatible bucket (AWS S3, Cloudflare R2, MinIO, Backblaze B2)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false
# Option B: shared directory (self-hosted). RECORDINGS_DIR is the app's path,
# EGRESS_OUTPUT_DIR the same volume as seen by the Egress container.
RECORDINGS_DIR=
EGRESS_OUTPUT_DIR=

# ---- Phone dial-in / dial-out: LiveKit SIP ----
LIVEKIT_SIP_INBOUND_TRUNK_ID=
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=
# Number shown to attendees, e.g. +1 555 010 0100
DIALIN_NUMBER=

# ---- AI meeting summaries: Anthropic Claude ----
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5
AI_SUMMARY_MODEL=

# ---- Billing: Stripe ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# ---- Operations ----
# Bearer token for POST /api/cron/cleanup (run hourly)
CRON_SECRET=
# Bearer token for GET /api/metrics (Prometheus); required in production
METRICS_TOKEN=
# Comma-separated emails with access to /admin
PLATFORM_ADMIN_EMAILS=
# Development only: allow webhooks/OIDC to private-network URLs
ALLOW_PRIVATE_OUTBOUND=false

# ---- Plan limits (all optional; shown defaults) ----
FREE_MAX_PARTICIPANTS=50
FREE_MAX_AUDIENCE=100
FREE_MAX_INVITATIONS=500
FREE_OTP_SENDS_PER_HOST_PER_DAY=200
FREE_INVITE_SENDS_PER_DAY=100
FREE_MONTHLY_PARTICIPANT_MINUTES=30000
PRO_MAX_PARTICIPANTS=150
PRO_MAX_AUDIENCE=1000
PRO_MONTHLY_PARTICIPANT_MINUTES=300000
PRO_PRICE_USD=15
BUSINESS_MAX_PARTICIPANTS=300
BUSINESS_MAX_AUDIENCE=10000
BUSINESS_MONTHLY_PARTICIPANT_MINUTES=2000000
BUSINESS_PRICE_USD=49
ENTERPRISE_MAX_PARTICIPANTS=500
ENTERPRISE_MAX_AUDIENCE=50000

# ---- Safety thresholds ----
SAFETY_JOIN_BURST=25
SAFETY_DENIED_BURST=15
SAFETY_OTP_BURST=60

# ---- docker compose (deploy/) ----
POSTGRES_PASSWORD=
APP_DOMAIN=
LIVEKIT_DOMAIN=
